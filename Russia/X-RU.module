#!name=BlockAds RU - X
#!desc=Явно помеченные рекламные записи в поддерживаемых GraphQL-лентах X. Сохраняет обычные записи и курсоры. Требует MITM; проверка на устройстве обязательна.
#!homepage=https://github.com/pivazyaa/blockads-ru/tree/main/Russia
# SPDX-License-Identifier: GPL-3.0-only
[Script]
RU-X = type=http-response, pattern=^https:\/\/(?:api\.)?(?:x|twitter)\.com\/(?:i\/api\/)?graphql\/[^\/?#]+\/(?:HomeTimeline|HomeLatestTimeline|TweetDetail|SearchTimeline|UserTweets|UserTweetsAndReplies)(?:\?|$), requires-body=true, max-size=1048576, timeout=5, engine=jsc, script-path=https://raw.githubusercontent.com/pivazyaa/blockads-ru/bb26272c251a7eff82050412c219def9ac881abd/Russia/social-json.js
[MITM]
hostname = %APPEND% x.com, twitter.com, api.x.com, api.twitter.com
